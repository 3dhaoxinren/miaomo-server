# LAN ONLY: bind to a fixed trusted LAN address reachable by the phone and ESP32.
# Do not expose either port through a public proxy, port forwarding, or a tunnel.
INKSIGHT_HOST=192.168.1.50
INKSIGHT_WEB_PORT=3000
INKSIGHT_BACKEND_PORT=8080
INKSIGHT_WEB_IMAGE=miaomo-server-web:local
INKSIGHT_BACKEND_IMAGE=miaomo-server-backend:local
