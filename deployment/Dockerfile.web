FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS build
ENV NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=2048
WORKDIR /app
COPY source/webapp/package.json source/webapp/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY source/webapp ./
ARG INKSIGHT_BACKEND_API_BASE=http://127.0.0.1:8080
ENV INKSIGHT_BACKEND_API_BASE=$INKSIGHT_BACKEND_API_BASE
ARG NEXT_PUBLIC_INKSIGHT_AUTH_MODE=lan
ENV NEXT_PUBLIC_INKSIGHT_AUTH_MODE=$NEXT_PUBLIC_INKSIGHT_AUTH_MODE
RUN npm run build

FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=127.0.0.1 PORT=3000 TZ=Asia/Shanghai
WORKDIR /app
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
COPY --chown=node:node LICENSE NOTICE ./
USER node
CMD ["node", "server.js"]
